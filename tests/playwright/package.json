{
  "name": "shopnest-playwright-tests",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "test": "playwright test --project=ui --project=mobile-chrome --project=mobile-safari",
    "test:smoke": "playwright test --project=ui --project=mobile-chrome --project=mobile-safari --grep @smoke",
    "test:desktop": "playwright test --project=ui",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:headed": "playwright test --project=ui --headed --workers=1",
    "test:debug": "playwright test --project=ui --debug",
    "test:ui-mode": "playwright test --ui",
    "test:list": "playwright test --project=ui --project=mobile-chrome --project=mobile-safari --list",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report artifacts/html-report",
    "report:summary": "node scripts/summarize-results.mjs artifacts/results.json"
  },
  "devDependencies": {
    "@faker-js/faker": "9.9.0",
    "@playwright/test": "1.64.1",
    "@types/node": "20.19.43",
    "dotenv": "18.0.8",
    "typescript": "5.7.2"
  }
}
