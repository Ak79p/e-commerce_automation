# Settings for the Playwright tests. Copy to .env (git-ignored) and fill in the two required account values.
# Never commit a real .env.

BASE_URL=http://localhost:5173

# Parallel workers. Empty = Playwright default (half the CPU cores); 2 on CI.
PW_WORKERS=
# true (default): Playwright starts `npm run dev` from the repo root, or reuses a server already on BASE_URL.
PW_START_SERVER=true
# Where reports, traces, screenshots, videos and the saved session are written (relative to tests/playwright).
PW_ARTIFACTS_DIR=artifacts
# true: also run the desktop suite in Firefox and WebKit (projects ui-firefox, ui-webkit).
PW_CROSS_BROWSER=false
# Fix the Faker seed for every test (default: a stable per-test seed, printed in each test's log).
FAKER_SEED=
# true: echo each test's log lines to the console (they are always attached to the HTML report).
PW_LOG=false

# REQUIRED: the seeded demo shopper the tests sign in with ("Demo User", USR-0001 in src/data/users.ts).
TEST_USER_EMAIL=<demo-user-email>
TEST_USER_PASSWORD=<demo-user-password>
# Optional fixed password (8-64 characters) for accounts the tests register; empty = generated per test.
TEST_NEW_USER_PASSWORD=
